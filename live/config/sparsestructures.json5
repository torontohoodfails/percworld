// percworld: structures spread out. Villages come in many modded forms (each its own structure set), so every one of them is listed here.
// Factor 2 = each structure type about a quarter as dense; 3 = about a ninth; 6 = about 1/36.
{
  "spreadFactor": 2,
  "idBasedSalt": true,
  "customSpreadFactors": [
    // villages, every kind
    { "structure": "minecraft:villages", "factor": 4 },
    { "structure": "nova_structures:villages_birch", "factor": 4 },
    { "structure": "nova_structures:villages_jungle", "factor": 4 },
    { "structure": "nova_structures:villages_swamp", "factor": 4 },
    { "structure": "nova_structures:ruin_town", "factor": 4 },
    { "structure": "repurposed_structures:villages_overworld", "factor": 4 },
    { "structure": "repurposed_structures:villages_mushroom", "factor": 4 },
    { "structure": "repurposed_structures:villages_nether", "factor": 4 },
    { "structure": "terralith:rare_village", "factor": 4 },
    { "structure": "towns_and_towers:towns", "factor": 4 },
    { "structure": "towns_and_towers:other", "factor": 4 },
    { "structure": "explorify:dark_forest_settlements", "factor": 4 },
    // the rest
    { "structure": "minecraft:ocean_monuments", "factor": 3 },
    { "structure": "minecraft:woodland_mansions", "factor": 2 }
  ]
}
